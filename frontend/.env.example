# Configuration pour le développement local
# Copiez ce fichier en .env.local pour le développement

# URL du backend FastAPI en développement
# En production sur Vercel, cette variable n'est pas nécessaire car frontend et backend sont sur la même origine
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pour le déploiement Vercel, la variable est automatiquement définie
# car le frontend et le backend sont sur la même origine (https://ehr-planning.vercel.app)
