{
  "version": 2,
  // Force redeploy - fix React imports
  "builds": [
    {
      "src": "api/handler.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 60 }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": { "installCommand": "npm install" }
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(?:css|js|ttf|woff2?|png|jpg|jpeg|gif|svg|ico))$",
      "dest": "frontend/$1"
    },
    {
      "src": "^/admin\\.html$",
      "dest": "public/admin.html"
    },
    {
      "src": "^/salles\\.html$",
      "dest": "public/salles.html"
    },
    {
      "src": "^/classements\\.html$",
      "dest": "public/classements.html"
    },
    {
      "src": "^/index\\.html$",
      "dest": "public/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/handler.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
